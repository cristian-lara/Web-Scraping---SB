{
  "uid": "bff-request-timings",
  "title": "BFF request list",
  "description": "Tabular view of recent spans — use with overview dashboard for charts",
  "tags": ["local-obs", "bff", "tempo", "table"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Friendly overview",
      "type": "link",
      "url": "/d/bff-overview/bff-at-a-glance",
      "targetBlank": false
    },
    {
      "title": "Explore by request.id",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22t%22:%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22queryType%22:%22traceqlSearch%22,%22refId%22:%22A%22%7D%5D%7D%7D&orgId=1",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Recent OpenTelemetry spans from `hn-scraper-bff` (Tempo).\n\n- **scrape.live** — HN fetch + parse duration\n- **filter.run** — filter strategy duration\n- **usageLog.write** — SQLite UsageLog write\n\nCorrelate with JSON logs: `docker compose logs backend` and header `x-request-id` / span attribute `request.id`.\n\nGenerate traffic: UI Filter A/B or `pnpm test:e2e:ci`."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "scrape.live (HN fetch)",
      "description": "Duration of live scrape spans",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"hn-scraper-bff\" && name = \"scrape.live\" }"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 300 },
                    { "color": "red", "value": 1000 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "filter.run",
      "description": "Duration of filter strategy spans",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"hn-scraper-bff\" && name = \"filter.run\" }"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 50 },
                    { "color": "red", "value": 200 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "usageLog.write",
      "description": "Duration of UsageLog persistence spans",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "limit": 30,
          "tableType": "traces",
          "query": "{ resource.service.name = \"hn-scraper-bff\" && name = \"usageLog.write\" }"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 50 },
                    { "color": "red", "value": 200 }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "All BFF spans (last hour)",
      "description": "Click a Trace ID to open the waterfall and inspect request.id",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "limit": 50,
          "tableType": "traces",
          "query": "{ resource.service.name = \"hn-scraper-bff\" }"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "unit", "value": "ms" }
            ]
          }
        ]
      }
    }
  ]
}
