generator client {
  provider      = "prisma-client-js"
  // native = host Vitest/dev; debian-openssl-3.0.x = node:22-bookworm Docker runner
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:app.db"
}

/// Usage metrics for a successful authenticated filter run (UsageLogSchema).
model UsageLog {
  id                  String   @id
  timestamp           DateTime
  filter_applied      String
  processed_items     Int
  execution_time_ms   Int
  userId              String
  requestId           String
  scrape_duration_ms  Int
}

/// Explicit user-saved filtered entry snapshot (SavedFilterResultSchema).
model SavedFilterResult {
  id             String   @id
  savedAt        DateTime
  userId         String
  filter_applied String
  /// JSON-serialized Entry[]
  entries        String
  entryCount     Int
  label          String?

  @@index([userId, savedAt])
}
