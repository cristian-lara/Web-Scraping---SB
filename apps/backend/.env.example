# Local BFF (copy to apps/backend/.env or export in shell)
PORT=3000

# JWT signing secret — change for any non-local use
JWT_SECRET=dev-only-change-me

# Demo user (idempotent in-memory auth bootstrap; JWT sub = userId on UsageLog)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo-password-change-me

# SQLite UsageLog store: apps/backend/prisma/app.db (schema url file:app.db)
# DATABASE_URL is not required; Prisma schema points at the local file.

# Optional throttle overrides (defaults: 60s window, 100 requests)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Live HN list URL used by AxiosHnHtmlFetcher (runtime only; unit tests use fixtures)
# HN_LIST_URL=https://news.ycombinator.com/

# Optional Sentry (empty = disabled; backend boots and serves without DSN)
SENTRY_DSN=

# Optional OpenTelemetry OTLP HTTP base URL (empty = no export; Compose collector e.g. http://otel-collector:4318)
# OTEL_EXPORTER_OTLP_ENDPOINT=
