{
  "name": "hn-scraper-mvp",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "test:e2e": "cd apps/backend/bruno && bru run --env local",
    "test:e2e:ci": "cd apps/backend/bruno && bru run HP1-auth-login.bru HP2-filter-a-comments.bru HP3-filter-b-points.bru E1-filters-no-auth.bru E2-invalid-filter.bru --env local",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@usebruno/cli": "4.2.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0"
  }
}
